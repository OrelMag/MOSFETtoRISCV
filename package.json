{
  "name": "mosfet-to-riscv",
  "private": true,
  "version": "0.1.0",
  "description": "An interactive journey from a single MOSFET to a multi-core RISC-V processor. Every block is a transparent box.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
